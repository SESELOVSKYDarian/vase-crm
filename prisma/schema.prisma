// ============================================================
// Vase Management — Prisma schema
// Ver DATABASE.md para el razonamiento detrás de cada modelo.
// Motor sugerido para producción: PostgreSQL.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------- Usuarios y permisos ----------------

enum Role {
  ADMIN
  ADMINISTRACION
  VENTAS
  PRODUCCION
  CORTE
  ARMADO
  DEPOSITO
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  arcaConnectionTests ArcaConnectionTest[]
  quotesCreated Quote[]        @relation("QuoteCreatedBy")
  otsAssigned   WorkOrder[]    @relation("WorkOrderOperario")
  sessions      Session[]
  userRoles     UserRole[]
  progressEntries ProductionProgressEntry[]
  otsCorte      WorkOrder[] @relation("WorkOrderCorte")
  otsArmado     WorkOrder[] @relation("WorkOrderArmado")
  otsProduccion WorkOrder[] @relation("WorkOrderProduccion")
}

model RoleDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  system      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

// ---------------- Clientes ----------------

enum CondicionIva {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
}

enum ClientStatus {
  ACTIVO
  INACTIVO
}

model Client {
  id            String       @id @default(cuid())
  codigoCliente String       @unique
  razonSocial   String
  cuit          String       @unique
  condicionIva  CondicionIva
  domicilio     String
  telefono      String?
  email         String?
  contacto      String?
  estado        ClientStatus @default(ACTIVO)
  observaciones String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  quotes        Quote[]
  workOrders    WorkOrder[]
  deliveryNotes DeliveryNote[]
  invoices      Invoice[]
  payments      Payment[]
  movements     AccountMovement[]

  @@index([razonSocial])
  @@index([cuit])
}

// ---------------- Catálogo y precios ----------------

enum ProductCategory {
  SIMPLE
  DVH
  TEMPLADO
  PULIDO
  SOLO_CORTE
  DISTRIBUCION
}

model Product {
  id         String          @id @default(cuid())
  nombre     String
  categoria  ProductCategory
  activo     Boolean         @default(true)
  categoryDefinitionId String?
  categoryDefinition ProductCategoryDefinition? @relation(fields: [categoryDefinitionId], references: [id])
  createdAt  DateTime        @default(now())

  priceItems PriceListItem[]

  @@index([categoria])
}

model ProductCategoryDefinition {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  sistema     Boolean  @default(false)
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
}

model PriceList {
  id          String          @id @default(cuid())
  nombre      String
  vigenteDesde DateTime
  vigenteHasta DateTime?
  activa      Boolean         @default(true)
  items       PriceListItem[]
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  precioM2    Decimal   @db.Decimal(14, 2)
  precioMl    Decimal?  @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())

  @@index([priceListId])
  @@index([productId])
}

// ---------------- Presupuestos ----------------

enum QuoteType {
  SIMPLE
  DVH
}

enum QuoteStatus {
  BORRADOR
  ENVIADO
  APROBADO
  RECHAZADO
  VENCIDO
  ANULADO
}

enum TipoFacturacion {
  A
  N
}

model Quote {
  id               String          @id @default(cuid())
  numero           String          @unique
  tipo             QuoteType
  fecha            DateTime        @default(now())
  fechaEntrega     DateTime
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  obra             String
  observaciones    String?
  estado           QuoteStatus     @default(BORRADOR)
  tipoFacturacion  TipoFacturacion @default(A)

  // Totales calculados y persistidos (no recalcular desde el front)
  cantidadTotal      Int
  m2Total            Decimal @db.Decimal(12, 3)
  subtotalBruto      Decimal @db.Decimal(14, 2)
  montoBonificacion  Decimal @db.Decimal(14, 2)
  subtotalNeto       Decimal @db.Decimal(14, 2)
  iva                Decimal @db.Decimal(14, 2)
  total              Decimal @db.Decimal(14, 2)

  createdById String?
  createdBy   User?   @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items            QuoteItem[]
  simpleGlassDetails SimpleGlassDetail[]
  dvhDetails         DvhDetail[]
  workOrder          WorkOrder?

  @@index([clientId])
  @@index([estado])
  @@index([tipoFacturacion])
}

// Ítem genérico de presupuesto — el detalle específico vive en
// SimpleGlassDetail o DvhDetail según `Quote.tipo`, evitando forzar
// campos irrelevantes de un tipo dentro del otro.
model QuoteItem {
  id           String  @id @default(cuid())
  quoteId      String
  quote        Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productoNombre String
  cantidad     Int
  anchoMm      Int
  altoMm       Int
  precioM2Snapshot Decimal @db.Decimal(14, 2)
  bonificacionPct  Decimal @db.Decimal(5, 2) @default(0)
  subtotalNeto     Decimal @db.Decimal(14, 2)

  simpleDetail SimpleGlassDetail?
  dvhDetail    DvhDetail?

  @@index([quoteId])
}

model SimpleGlassDetail {
  id                    String    @id @default(cuid())
  quoteId               String
  quote                 Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteItemId           String    @unique
  quoteItem             QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  carasPulidasAncho      Int      @default(0)
  carasPulidasAlto       Int      @default(0)
  metrosLinealesPulido   Decimal  @db.Decimal(12, 3)
  precioPulidoMlSnapshot Decimal  @db.Decimal(14, 2)
  observacionesPulido    String

  @@index([quoteId])
}

model DvhDetail {
  id                   String    @id @default(cuid())
  quoteId              String
  quote                Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteItemId          String    @unique
  quoteItem            QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  composicion          String
  vidrioExteriorTipo   String
  vidrioExteriorEspesorMm Int
  vidrioExteriorPrecioM2Snapshot Decimal @db.Decimal(14, 2)
  vidrioInteriorTipo   String
  vidrioInteriorEspesorMm Int
  vidrioInteriorPrecioM2Snapshot Decimal @db.Decimal(14, 2)
  camara               String
  separador            String
  sellado              String
  precioSeparadorMlSnapshot Decimal @db.Decimal(14, 2)
  precioSelladoMlSnapshot   Decimal @db.Decimal(14, 2)
  costoInsumosExtraUnitario Decimal @db.Decimal(14, 2)
  margenPct            Decimal @db.Decimal(5, 2)
  costoTotalUnitario   Decimal @db.Decimal(14, 2)

  @@index([quoteId])
}

// ---------------- Órdenes de trabajo ----------------

enum WorkOrderStatus {
  PENDIENTE
  EN_PROCESO
  TERMINADA
  ANULADA
}

enum DeliveryStatus {
  SIN_ENTREGAR
  ENTREGA_PARCIAL
  ENTREGA_COMPLETA
}

enum InvoiceStatus {
  SIN_FACTURAR
  FACTURADA_PARCIAL
  FACTURADA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

model WorkOrder {
  id             String   @id @default(cuid())
  numero         String   @unique
  quoteId        String   @unique
  quote          Quote    @relation(fields: [quoteId], references: [id])
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  obra           String
  categoria      ProductCategory
  fechaCreacion  DateTime @default(now())
  fechaEntrega   DateTime
  prioridad      Prioridad @default(MEDIA)
  observaciones  String?
  porcentajeAvance Int    @default(0)

  estadoProductivo WorkOrderStatus @default(PENDIENTE)
  estadoEntrega    DeliveryStatus  @default(SIN_ENTREGAR)
  estadoFacturacion InvoiceStatus  @default(SIN_FACTURAR)

  operarioId String?
  operario   User?   @relation("WorkOrderOperario", fields: [operarioId], references: [id])
  corteUsuarioId String?
  corteUsuario User? @relation("WorkOrderCorte", fields: [corteUsuarioId], references: [id])
  armadoUsuarioId String?
  armadoUsuario User? @relation("WorkOrderArmado", fields: [armadoUsuarioId], references: [id])
  produccionUsuarioId String?
  produccionUsuario User? @relation("WorkOrderProduccion", fields: [produccionUsuarioId], references: [id])

  items       WorkOrderItem[]
  cutOrder    CutOrder?
  assemblyOrder AssemblyOrder?
  deliveries    Delivery[]
  deliveryNotes DeliveryNote[]
  invoices      Invoice[]
  progressEntries ProductionProgressEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([estadoProductivo])
  @@index([estadoEntrega])
  @@index([estadoFacturacion])
}

enum ProductionTaskType {
  CORTE
  ARMADO
  PRODUCCION
}

model ProductionProgressEntry {
  id         String @id @default(cuid())
  workOrderId String
  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId     String
  user       User @relation(fields: [userId], references: [id])
  task       ProductionTaskType
  date       DateTime
  quantity   Int
  note       String?
  createdAt  DateTime @default(now())
  @@index([workOrderId, task])
  @@index([userId, date])
}

model WorkOrderItem {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  productoNombre String
  cantidad    Int
  anchoMm     Int
  altoMm      Int
  m2          Decimal   @db.Decimal(12, 3)

  @@index([workOrderId])
}

// ---------------- Corte ----------------

model CutOrder {
  id          String   @id @default(cuid())
  workOrderId String   @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  fechaIngreso DateTime?
  fechaFinalizacion DateTime?
  operario    String?
  observaciones String?

  items CutOrderItem[]
}

model CutOrderItem {
  id             String   @id @default(cuid())
  cutOrderId     String
  cutOrder       CutOrder @relation(fields: [cutOrderId], references: [id], onDelete: Cascade)
  productoNombre String
  cantidad       Int
  anchoMm        Int
  altoMm         Int
  m2             Decimal  @db.Decimal(12, 3)
  observacionesPulido String?
  conteoVidrio   Int      @default(0)

  @@index([cutOrderId])
}

// ---------------- Armado DVH ----------------

model AssemblyOrder {
  id          String   @id @default(cuid())
  workOrderId String   @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  fechaIngreso DateTime?
  fechaFinalizacion DateTime?
  operario    String?
  observaciones String?

  items AssemblyOrderItem[]
}

model AssemblyOrderItem {
  id              String        @id @default(cuid())
  assemblyOrderId String
  assemblyOrder   AssemblyOrder @relation(fields: [assemblyOrderId], references: [id], onDelete: Cascade)
  composicion     String
  vidrio1         String
  vidrio2         String
  camara          String
  separador       String
  sellado         String
  cantidad        Int
  anchoMm         Int
  altoMm          Int
  observaciones   String?

  @@index([assemblyOrderId])
}

// ---------------- Entregas ----------------

model Delivery {
  id            String   @id @default(cuid())
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])
  fecha         DateTime @default(now())
  cantidadEntregada Int
  deliveryNoteId String? @unique
  deliveryNote DeliveryNote? @relation(fields: [deliveryNoteId], references: [id])

  items DeliveryItem[]

  @@index([workOrderId])
}

model DeliveryItem {
  id          String   @id @default(cuid())
  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productoNombre String
  cantidad    Int

  @@index([deliveryId])
}

// ---------------- Remitos ----------------

enum DeliveryNoteStatus {
  BORRADOR
  CONFIRMADO
  ANULADO
}

model DeliveryNote {
  id            String   @id @default(cuid())
  numero        String   @unique
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  fecha         DateTime @default(now())
  direccion     String
  transportista String?
  observaciones String?
  estado        DeliveryNoteStatus @default(BORRADOR)
  motivoAnulacion String?
  confirmadoAt  DateTime?

  items DeliveryNoteItem[]
  delivery Delivery?

  createdAt DateTime @default(now())

  @@index([workOrderId])
  @@index([clientId])
}

model DeliveryNoteItem {
  id             String       @id @default(cuid())
  deliveryNoteId String
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  productoNombre String
  cantidadPedida    Int
  cantidadEntregada Int

  @@index([deliveryNoteId])
}

// ---------------- Facturación / ARCA ----------------

enum ArcaVoucherType {
  FACTURA_A
  FACTURA_B
  FACTURA_C
  NOTA_CREDITO_A
  NOTA_CREDITO_B
}

enum ArcaStatus {
  NO_APLICA
  PENDIENTE
  AUTORIZADA
  RECHAZADA
  ERROR
}

enum InvoicePaymentStatus {
  PENDIENTE
  PARCIAL
  PAGADA
}

model Invoice {
  id               String          @id @default(cuid())
  numero           String          @unique
  tipoFacturacion  TipoFacturacion
  arcaVoucherType  ArcaVoucherType?
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  workOrderId      String
  workOrder        WorkOrder       @relation(fields: [workOrderId], references: [id])
  fecha            DateTime        @default(now())
  cuit             String
  condicionIva     CondicionIva
  puntoVenta       Int
  moneda           String          @default("ARS")
  subtotal         Decimal         @db.Decimal(14, 2)
  iva              Decimal         @db.Decimal(14, 2)
  tributos         Decimal         @db.Decimal(14, 2) @default(0)
  total            Decimal         @db.Decimal(14, 2)
  cae              String?
  vencimientoCae   DateTime?
  estadoArca       ArcaStatus      @default(NO_APLICA)
  estadoPago       InvoicePaymentStatus @default(PENDIENTE)

  arcaTransactions ArcaTransaction[]
  items            InvoiceItem[]
  allocations      PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([workOrderId])
  @@index([tipoFacturacion])
  @@index([estadoArca])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  descripcion    String
  cantidad       Int
  precioUnitario Decimal @db.Decimal(14, 2)
  subtotal       Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
}

// Log técnico e idempotente de cada intento de autorización ante ARCA.
model ArcaTransaction {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  idempotencyKey  String   @unique
  environment     String
  requestPayload  Json
  responsePayload Json?
  resultado       ArcaStatus
  errores         Json?
  createdAt       DateTime @default(now())

  @@index([invoiceId])
}

// ---------------- Cobros ----------------

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE_FISICO
  ECHEQ
  CHEQUE_TERCEROS
  DOLARES
  OTRO
}

enum PaymentApplicationTarget {
  OT_ESPECIFICA
  ACOPIO
  CUENTA_CORRIENTE
}

model Payment {
  id            String        @id @default(cuid())
  numero        String        @unique
  fecha         DateTime      @default(now())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  recibo        String
  metodo        PaymentMethod
  moneda        String        @default("ARS")
  importe       Decimal       @db.Decimal(14, 2)
  montoUsd            Decimal? @db.Decimal(14, 2)
  tipoCambio          Decimal? @db.Decimal(10, 4)
  fechaTipoCambio     DateTime?
  montoEquivalenteArs Decimal? @db.Decimal(14, 2)
  observaciones String?

  retentions  Retention[]
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())

  @@index([clientId])
}

model Retention {
  id             String  @id @default(cuid())
  paymentId      String
  payment        Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  agenteRetencion String
  monto          Decimal @db.Decimal(14, 2)
  tipoRetencion  String
  comprobante    String?
  observaciones  String?

  @@index([paymentId])
}

// Distribución de un pago entre OT específica, acopio o cuenta corriente,
// sin duplicar el monto original del pago.
model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  target    PaymentApplicationTarget
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  monto     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

// ---------------- Cuenta corriente ----------------

enum AccountMovementType {
  PRESUPUESTO
  FACTURA
  PAGO
  RETENCION
  AJUSTE
}

model AccountMovement {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  fecha      DateTime @default(now())
  tipo       AccountMovementType
  referencia String
  debe       Decimal  @db.Decimal(14, 2) @default(0)
  haber      Decimal  @db.Decimal(14, 2) @default(0)
  saldo      Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@index([fecha])
}

// ---------------- Auditoría ----------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  accion     String
  entidad    String
  entidadId  String
  valorAnterior Json?
  valorNuevo    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([userId])
}

// ---------------- Configuración general ----------------

model CompanySettings {
  id              String  @id @default(cuid())
  razonSocial     String
  cuit            String
  condicionIva    CondicionIva
  puntoVentaDefault Int
  arcaEnvironment String  @default("HOMOLOGACION")
  arcaCuit        String?
  arcaPuntoVenta  Int?
  arcaCertificate String? @db.LongText
  arcaPrivateKey  String? @db.LongText
  arcaService     String  @default("wsfe")
  arcaCertificateSubject String?
  arcaCertificateIssuer String?
  arcaCertificateSerial String?
  arcaCertificateValidFrom DateTime?
  arcaCertificateValidTo DateTime?
  arcaLastConnectionTestAt DateTime?
  arcaLastConnectionStatus String?
  arcaLastConnectionMessage String? @db.Text
  logoData        String? @db.LongText
}

model ArcaAccessTicket {
  id             String   @id @default(cuid())
  environment    String
  cuit           String
  service        String
  tokenEncrypted String   @db.LongText
  signEncrypted  String   @db.LongText
  generationTime DateTime
  expirationTime DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([environment, cuit, service])
  @@index([expirationTime])
}

model ArcaConnectionTest {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  environment String
  testType   String
  status     String
  durationMs Int?
  errorCode  String?
  message    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([environment, testType])
}
